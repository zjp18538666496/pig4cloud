# ============================================================
# pig4cloud admin 前后端一体 Nginx 参考配置
# 用法：修改 dist 路径与后端地址后，放入 /etc/nginx/conf.d/ 并 reload
#   cp nginx.conf.example /etc/nginx/conf.d/pigx-admin.conf
#   nginx -t && nginx -s reload
# ============================================================

server {
    listen 80;
    server_name _;

    # 文件上传大小（后端multipart不限制，这里放开）
    client_max_body_size 1024m;

    # ---------- 前端静态页（web/dist 产物） ----------
    location / {
        root /opt/pigx-admin/dist;
        # history路由：刷新业务页面时回退到index.html，必备
        try_files $uri $uri/ /index.html;
    }

    # ---------- 后端接口 ----------
    location /api/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 文件上传/下载超时放宽
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---------- 站内信WebSocket（/ws/{token}） ----------
    location /ws/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---------- 可选：gzip压缩静态资源 ----------
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1k;
}
