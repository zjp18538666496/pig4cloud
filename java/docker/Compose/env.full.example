# docker-compose.full.yml 环境变量模板：复制为 .env 后填写
JWT_SECRET=请用openssl_rand_-base64_32生成
CORS_ORIGINS=*
DB_INIT=true
MYSQL_PASSWORD=请设置MySQL密码
MONGO_PASSWORD=请设置Mongo密码
REDIS_PASSWORD=请设置Redis密码
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=请设置MinIO密码
S3_BUCKET=pigx-admin
# 登录方式扩展（默认全关，按需开启并填对应参数）
SMS_ENABLED=false
SMS_MOCK=false
LDAP_ENABLED=false
OIDC_ENABLED=false
# OIDC_CLIENT_ID/OIDC_CLIENT_SECRET/OIDC_AUTHORIZE_URI/OIDC_TOKEN_URI/OIDC_USERINFO_URI/OIDC_REDIRECT_URI=按IdP填写
# 验证码类型：image | slider
CAPTCHA_TYPE=image
# 生产务必关闭接口文档
SWAGGER_ENABLED=false
