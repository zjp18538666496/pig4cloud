# 复制本文件为 application-local.yaml（已被.gitignore忽略），按需修改
spring:
  datasource:
    username: root
    password: your-db-password
  data:
    mongodb:
      # 操作日志库；账号建在admin库时必须指定authSource=admin
      uri: mongodb://root:your-mongo-password@127.0.0.1:27017/pigx_log?authSource=admin
    redis:
      # app.store.type=redis时启用（REDIS_HOST/REDIS_PORT/REDIS_PASSWORD环境变量优先）
      host: 10.126.126.3
      port: 6379
      # password: your-redis-password
  # 找回密码邮件（可选）：配置后需同时设置 app.mail.enabled=true（或环境变量MAIL_ENABLED=true）
  # mail:
  #   host: smtp.qq.com
  #   port: 465
  #   username: your-email@qq.com
  #   password: your-smtp-authorization-code
  #   properties:
  #     mail.smtp.ssl.enable: true
ftp:
  server: 127.0.0.1
  port: 21
  user: root
  password: your-ftp-password
# S3对象存储（app.storage.type=s3时使用；本地开发可用docker run -p 9000:9000 minio/minio）
# s3:
#   endpoint: http://127.0.0.1:9000
#   access-key: minioadmin
#   secret-key: your-s3-secret
#   bucket: pigx-admin
#   path-style-access: true
jwt:
  # 生成方式: openssl rand -base64 32
  secret: your-base64-secret-at-least-32-bytes
